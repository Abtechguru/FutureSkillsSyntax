# Copy to backend/.env for LOCAL development only. Never commit real values.
APP_NAME="Future Syntax"
ENVIRONMENT=development
DEBUG=false
SECRET_KEY=your-secret-key-change-in-production
DATABASE_URL=postgresql+asyncpg://postgres:postgres@127.0.0.1:5432/futuresyntax
CORS_ORIGINS=["http://localhost:5173"]
FRONTEND_URL=http://localhost:5173

# Transactional email must be configured for production onboarding.
EMAILS_ENABLED=false
DEV_LOG_EMAILS=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_FROM_NAME="Future Syntax"

# Optional integrations; disabled unless explicitly approved and provisioned.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
MONGODB_URI=
GOALS_ENABLED=false
CAREER_API_ENABLED=false
CHILD_INTERACTIVE_FEATURES_ENABLED=false
CODE_EXECUTION_ENABLED=false
MENTOR_ONBOARDING_ENABLED=false
MENTOR_MATCHING_ENABLED=false
MENTORSHIP_SCHEDULING_ENABLED=false
AVATAR_UPLOADS_ENABLED=false
NON_AVATAR_UPLOADS_ENABLED=false
PAYMENTS_ENABLED=false
PUBLIC_LEADERBOARDS_ENABLED=false
